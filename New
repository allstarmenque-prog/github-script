			flySpeedBtn.BackgroundColor3 = Color3.fromRGB(0,100,255)
		end)
	end)

	RunService.RenderStepped:Connect(function()
		if not isFlying or not flyBV or not flyGyro then return end
		local char = player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end

		local camCF = camera.CFrame
		local forward3D = camCF.LookVector
		local rightXZ = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
		if rightXZ.Magnitude > 0 then rightXZ = rightXZ.Unit end

		local move = Vector3.zero

		-- PC controls
		if UserInputService.KeyboardEnabled then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += forward3D end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= forward3D end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= rightXZ end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += rightXZ end
		end

		-- Mobile joystick (Humanoid MoveDirection)
		if UserInputService.TouchEnabled then
			local dir = hum.MoveDirection
			if dir.Magnitude > 0 then
				local forwardXZ = Vector3.new(forward3D.X, 0, forward3D.Z)
				if forwardXZ.Magnitude > 0 then forwardXZ = forwardXZ.Unit end
				local mF = dir:Dot(forwardXZ)
				local mR = dir:Dot(rightXZ)
				move = (forward3D * mF) + (rightXZ * mR)
			end
		end

		if move.Magnitude > 0 then
			flyBV.Velocity = move.Unit * flySpeed
		else
			flyBV.Velocity = Vector3.zero
		end

		flyGyro.CFrame = CFrame.new(root.Position, root.Position + camCF.LookVector)
	end)

